# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=7d

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -- CORS ----------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# Leave unset in development to allow any origin.
CORS_ORIGINS=http://localhost:3000

# -- Email (Zoho Mail) ---------------------------------------
# Create an app password in Zoho: Accounts > Security > App Passwords.
# Use the smtp host for your Zoho data centre: smtp.zoho.com, smtp.zoho.eu, smtp.zoho.in or smtp.zoho.com.au.
# Leave ZOHO_SMTP_USER empty to run without email (messages are saved but no emails go out).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@yourdomain.org
ZOHO_SMTP_PASS=your_zoho_app_password
# Optional display sender. The address must be the same mailbox as ZOHO_SMTP_USER.
MAIL_FROM=AgroNext <hello@yourdomain.org>
# Where new applications and enquiries are sent. Defaults to ZOHO_SMTP_USER.
ADMIN_NOTIFY_EMAIL=team@yourdomain.org
# Public address of the website, used for links in emails (password setup and reset).
FRONTEND_URL=http://localhost:3000
